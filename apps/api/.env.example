# Kairos Backend 환경변수 템플릿
# cp .env.example .env 후 실제 값을 입력하세요
# 발급처 및 CI/프로덕션 설정 → docs/development/secrets.md

# 앱
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname

# 인증 (ADR-031 — Better Auth 가 Next.js 에서 발급, 백엔드는 JWKS 로 서명만 검증)
#
# ★issuer 와 JWKS URL 은 별개다. issuer 는 토큰의 iss/aud 클레임과 대조하는 값(FE 공개 URL)이고,
#   AUTH_JWKS_URL 은 공개키를 실제로 가져올 주소다. 프로덕션에서는 JWKS 만 compose 내부망으로
#   돌려 Cloudflare Tunnel 왕복을 뺀다:
#     AUTH_JWT_ISSUER=https://kairos.woosung.dev
#     AUTH_JWKS_URL=http://web:3000/api/auth/jwks
# non-dev(production/staging)에서 loopback 주소를 쓰면 부팅이 막힌다.
AUTH_JWT_ISSUER=http://localhost:3000
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
# Better Auth 기본 audience = baseURL. non-dev 에서는 명시 필수.
AUTH_JWT_AUDIENCE=
# Better Auth jwt 플러그인 기본 서명 알고리즘. 헤더의 alg 를 신뢰하지 않기 위한 허용 목록이다.
AUTH_JWT_ALGORITHMS=EdDSA
# prod 하드닝 게이트. true(기본)면 위 검증 위반 시 부팅 차단, false 면 warning 으로 전환.
AUTH_PROD_HARDENING=true

# Cloudflare R2 (파일 저장소)
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=kairos-uploads

# AI
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=sk-xxx

# Google Drive Integrations (ADR-026 D10 — v0 미구현 상태에서는 비워두면 기존 부팅에 영향 없음)
# INTEGRATIONS_ENCRYPTION_KEY 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Google Cloud Console > APIs & Services > Credentials 에서 OAuth client ID/secret 및 Picker API key 발급
INTEGRATIONS_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google-drive/callback
GOOGLE_PICKER_API_KEY=

# Cron (Sprint 15 R-CRON — R2 30일 voice cleanup admin endpoint 인증)
# 발급: openssl rand -hex 32
# Cloud Scheduler에서 X-Cron-Token 헤더로 매일 03:00 KST 호출
CRON_SECRET_TOKEN=dev-cron-secret-CHANGE-ME-IN-PROD

# Multi-Agent QA cleanup safety (Sprint 18 → 19, scripts/seed_qa_fixtures.py)
# 비워두면 가드 미적용. founder 의 users.id (내부 UUID) 입력 시 cleanup 진행 중 founder
# 소유 워크스페이스가 매칭되면 즉시 ABORT.
KAIROS_FOUNDER_USER_ID=

# 배포 환경 라벨. app_env 와 분리돼 있으며 production 판정(docs 차단)에 함께 쓰인다.
# Sentry 는 ADR-028 로 제거됐다.
ENVIRONMENT=development
