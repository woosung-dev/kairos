# Kairos Backend 환경변수 템플릿
# cp .env.example .env 후 실제 값을 입력하세요
# 발급처 및 CI/프로덕션 설정 → docs/guides/secrets.md

# 앱
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname

# Clerk (인증)
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Cloudflare R2 (파일 저장소)
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=kairos-uploads

# AI
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=sk-xxx

# Google Drive Integrations (ADR-026 D10 — v0 미구현 상태에서는 비워두면 기존 부팅에 영향 없음)
# INTEGRATIONS_ENCRYPTION_KEY 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Google Cloud Console > APIs & Services > Credentials 에서 OAuth client ID/secret 및 Picker API key 발급
INTEGRATIONS_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google-drive/callback
GOOGLE_PICKER_API_KEY=

# Cron (Sprint 15 R-CRON — R2 30일 voice cleanup admin endpoint 인증)
# 발급: openssl rand -hex 32
# Cloud Scheduler에서 X-Cron-Token 헤더로 매일 03:00 KST 호출
CRON_SECRET_TOKEN=dev-cron-secret-CHANGE-ME-IN-PROD

# Multi-Agent QA cleanup safety (Sprint 18 → 19, scripts/seed_qa_fixtures.py)
# 비워두면 가드 미적용. founder clerk_id 입력 시 cleanup 진행 중 founder
# 소유 워크스페이스가 매칭되면 즉시 ABORT.
KAIROS_FOUNDER_CLERK_ID=

# Sentry Observability (Sprint 22 Task 7 — ADR-021)
# DSN 비워두면 Sentry 초기화 안 함 (dev 기본). staging/production 에서만 설정.
# 발급: https://sentry.io > Project > Settings > Client Keys (DSN)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# ENVIRONMENT 는 app_env 와 분리. Sentry 대시보드 필터링 키.
ENVIRONMENT=development
