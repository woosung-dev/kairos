# Kairos Frontend 환경변수 템플릿
# 이 파일을 .env.local로 복사한 후 실제 값을 입력하세요

# 백엔드 API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Sprint 15 Recall-first wedge — Memory 도메인 활성화 플래그
# true일 때만 사이드바 Memory 항목 + /memory 라우트 노출
NEXT_PUBLIC_RECALL_ENABLED=true

# Clerk (인증)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Sprint 15 R7 — Founder admin /admin/recall-metrics 페이지 gate
# 본인 Clerk user_id (user_xxx 형태). Clerk 대시보드 > Users 또는 /api/v1/users/me 응답에서 확인
NEXT_PUBLIC_FOUNDER_CLERK_ID=user_xxx

# ─── E2E 테스트 (Playwright) ───
# 로컬에서 `pnpm e2e` 실행 시 필요.
# Clerk 대시보드에서 email+password 방식으로 등록한 테스트 계정 정보를 입력.
# CI에서는 GitHub Secrets (E2E_USER_EMAIL, E2E_USER_PASSWORD)에 등록.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# 선택: E2E가 바라볼 FE port/URL. 기본은 3003.
# E2E_PORT=3003
# E2E_BASE_URL=http://localhost:3003

# ─── 배포 환경 라벨 (ADR-028) ───
# Sentry event 의 environment 값. Vercel 시절에는 NEXT_PUBLIC_VERCEL_ENV 가 자동 주입됐지만
# OCI 셀프호스팅에는 그 변수가 없다. 이미지 빌드 시 --build-arg 로 넣는다.
# 미설정 시 fallback 체인(APP_ENV → VERCEL_ENV → "development")이 동작한다.
NEXT_PUBLIC_APP_ENV=development
