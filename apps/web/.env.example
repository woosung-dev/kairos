# Kairos Frontend 환경변수 템플릿
# 이 파일을 .env.local로 복사한 후 실제 값을 입력하세요

# 백엔드 API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Sprint 15 Recall-first wedge — Memory 도메인 활성화 플래그
# true일 때만 사이드바 Memory 항목 + /memory 라우트 노출
NEXT_PUBLIC_RECALL_ENABLED=true

# 인증 — Better Auth (ADR-031). 전부 **서버 전용 런타임 env** 다.
# NEXT_PUBLIC_ 접두사를 붙이면 브라우저 번들에 박히므로 절대 붙이지 않는다.
#
# BETTER_AUTH_SECRET: 세션 쿠키 서명 + auth_jwks.privateKey 암호화 키를 겸한다.
#   유출되면 임의 사용자의 JWT 를 위조할 수 있다 (백엔드는 서명만 믿는 리소스 서버다).
#   생성: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# node-postgres 형식이다. 백엔드의 postgresql+asyncpg:// DSN 을 그대로 넣으면 안 된다.
BETTER_AUTH_DATABASE_URL=postgresql://user:pass@localhost:5432/kairos
# Google OAuth — ★Drive 연동(ADR-026)의 GOOGLE_OAUTH_CLIENT_ID 와 **다른 클라이언트**다.
#   Drive 는 restricted scope 라 앱 검증 대상이고, 로그인을 같은 클라이언트에 얹으면
#   로그인이 그 검증 반경에 딸려 들어간다. 같은 GCP 프로젝트에 클라이언트를 따로 만든다.
#   redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sprint 15 R7 — Founder admin /admin/recall-metrics 페이지 gate
# 본인의 **내부** user id (users.id UUID). GET /api/v1/users/me 응답의 id 필드.
NEXT_PUBLIC_FOUNDER_USER_ID=

# ─── E2E 테스트 (Playwright) ───
# 로컬에서 `pnpm e2e` 실행 시 필요.
# 앱의 /sign-up 에서 email+password 로 등록한 테스트 계정 정보를 입력.
# CI에서는 GitHub Secrets (E2E_USER_EMAIL, E2E_USER_PASSWORD)에 등록.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# 선택: E2E가 바라볼 FE port/URL. 기본은 3003.
# E2E_PORT=3003
# E2E_BASE_URL=http://localhost:3003

# ─── 배포 환경 라벨 (ADR-028) ───
# Sentry event 의 environment 값. Vercel 시절에는 NEXT_PUBLIC_VERCEL_ENV 가 자동 주입됐지만
# OCI 셀프호스팅에는 그 변수가 없다. 이미지 빌드 시 --build-arg 로 넣는다.
# 미설정 시 fallback 체인(APP_ENV → VERCEL_ENV → "development")이 동작한다.
NEXT_PUBLIC_APP_ENV=development
