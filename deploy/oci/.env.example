# Kairos OCI 배포 환경변수 템플릿 (ADR-028)
#
# 이 파일을 서버의 ~/kairos/.env 로 복사한 뒤 값만 채운다. chmod 600 필수.
#
# ###########################################################################
# 규칙: 값 뒤에 인라인 주석을 절대 붙이지 말 것.
#   docker compose 의 env_file 파서는 `KEY=value  # 설명` 에서 주석을 값의 일부로 읽는다.
#   한글 주석이 값에 섞이면 Clerk SDK 가 헤더 ascii 인코딩에서 터져 401 이 아니라 500 이 나고,
#   CORS_ORIGINS 는 쉼표 파싱이라 오염이 조용히 CORS 전면 차단으로 나타난다.
#   설명은 이 파일처럼 반드시 별도 줄 주석으로만 쓴다.
#
# 검증: LC_ALL=C grep -n '[^[:print:][:space:]]' ~/kairos/.env  →  출력 0줄이어야 한다.
# ###########################################################################

# --- 이미지 태그 (배포 단위) -----------------------------------------------
# git short SHA. 롤백은 이 두 줄을 이전 값으로 되돌리고 `up -d`.
KAIROS_API_TAG=
KAIROS_WEB_TAG=

# --- Cloudflare Tunnel -----------------------------------------------------
# Zero Trust > Networks > Tunnels 에서 발급한 토큰 (eyJhIjoi... 형태)
KAIROS_TUNNEL_TOKEN=

# --- PostgreSQL (컨테이너 내부) --------------------------------------------
POSTGRES_USER=kairos
POSTGRES_PASSWORD=
POSTGRES_DB=kairos

# --- 앱 기본 ---------------------------------------------------------------
APP_ENV=production
ENVIRONMENT=production
LOG_LEVEL=INFO

# CLERK_PROD_HARDENING=false 는 ADR-022/024 잔재를 그대로 승계한 것이다.
# prod 가 dev Clerk 인스턴스를 쓰고 있어 27e validator 가 부팅을 막는다.
# ADR-024 Clerk Production 컷오버 완료 시 true 로 재무장하고 이 줄을 지운다.
CLERK_PROD_HARDENING=false

# --- URL / CORS ------------------------------------------------------------
# Cloud Run 때는 deploy-cloudrun 액션이 쉼표를 변수 구분자로 읽어 단일 값만 넣을 수 있었다.
# 여기서는 그 제약이 없다 - 쉼표로 여러 오리진을 넣어도 된다.
FRONTEND_URL=https://kairos.woosung.dev
CORS_ORIGINS=https://kairos.woosung.dev

# --- DB 접속 ---------------------------------------------------------------
# 호스트명 db = compose 서비스명. POSTGRES_PASSWORD 와 같은 값을 넣어야 한다.
DATABASE_URL=postgresql+asyncpg://kairos:CHANGE_ME@db:5432/kairos

# --- Clerk -----------------------------------------------------------------
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWT_ISSUER=https://creative-boxer-79.clerk.accounts.dev

# --- Cloudflare R2 ---------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- AI ---------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- 업로드 한도 -------------------------------------------------------------
# 90MB. 코드 기본값은 500MB 지만 Cloudflare Free/Pro 는 요청 바디를 100MB 에서 자른다.
# 엣지가 반환하는 413 에는 CORS 헤더가 없어 브라우저 콘솔에는 CORS 오류로 보인다.
# 서버가 먼저 한국어 메시지로 거절하도록 낮춰 둔다.
# 실측(2026-08-14): 회의 87건 중 최장 5.1분 / 약 5MB 이므로 여유는 20배다.
MAX_UPLOAD_BYTES=94371840

# --- 통합 / OAuth ------------------------------------------------------------
INTEGRATIONS_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://kairos-api.woosung.dev/api/v1/integrations/google-drive/callback
GOOGLE_PICKER_API_KEY=

# --- 운영 --------------------------------------------------------------------
# openssl rand -hex 32 로 생성. 미설정 시 코드 기본값(공개 리포에 적힌 문자열)이 쓰인다.
CRON_SECRET_TOKEN=

# 비워두면 Sentry 초기화를 건너뛴다.
SENTRY_DSN=
