# Kairos OCI 배포 환경변수 템플릿 (ADR-028)
#
# 이 파일을 서버의 ~/kairos/.env 로 복사한 뒤 값만 채운다. chmod 600 필수.
#
# ###########################################################################
# 규칙: 값 뒤에 인라인 주석을 절대 붙이지 말 것.
#   docker compose 의 env_file 파서는 `KEY=value  # 설명` 에서 주석을 값의 일부로 읽는다.
#   한글 주석이 값에 섞이면 헤더 ascii 인코딩에서 터져 401 이 아니라 500 이 나고,
#   CORS_ORIGINS 는 쉼표 파싱이라 오염이 조용히 CORS 전면 차단으로 나타난다.
#   설명은 이 파일처럼 반드시 별도 줄 주석으로만 쓴다.
#
# 검증: LC_ALL=C grep -n '[^[:print:][:space:]]' ~/kairos/.env  →  출력 0줄이어야 한다.
# ###########################################################################

# --- 이미지 태그 (배포 단위) -----------------------------------------------
# git short SHA. 롤백은 이 두 줄을 이전 값으로 되돌리고 `up -d`.
KAIROS_API_TAG=
KAIROS_WEB_TAG=

# --- Cloudflare Tunnel -----------------------------------------------------
# Zero Trust > Networks > Tunnels 에서 발급한 토큰 (eyJhIjoi... 형태)
KAIROS_TUNNEL_TOKEN=

# --- PostgreSQL (컨테이너 내부) --------------------------------------------
POSTGRES_USER=kairos
POSTGRES_PASSWORD=
POSTGRES_DB=kairos

# --- 앱 기본 ---------------------------------------------------------------
APP_ENV=production
ENVIRONMENT=production
LOG_LEVEL=INFO

# ADR-031 로 하드닝을 재무장했다. 이제 우리가 발급자를 소유하므로
# "prod 인데 dev 발급자" 라는 모순 자체가 없다. 끄지 않는 것이 정상 상태다.
# (비상시에만 false — 그때도 위반은 WARNING 으로 반드시 로그에 남는다.)
AUTH_PROD_HARDENING=true

# --- URL / CORS ------------------------------------------------------------
# Cloud Run 때는 deploy-cloudrun 액션이 쉼표를 변수 구분자로 읽어 단일 값만 넣을 수 있었다.
# 여기서는 그 제약이 없다 - 쉼표로 여러 오리진을 넣어도 된다.
FRONTEND_URL=https://kairos.woosung.dev
CORS_ORIGINS=https://kairos.woosung.dev

# --- DB 접속 ---------------------------------------------------------------
# 호스트명 db = compose 서비스명. POSTGRES_PASSWORD 와 같은 값을 넣어야 한다.
DATABASE_URL=postgresql+asyncpg://kairos:CHANGE_ME@db:5432/kairos

# --- 인증 (ADR-031 · 백엔드는 JWKS 로 서명만 검증) ---------------------------
# ★이 템플릿에는 CLERK_* 가 없다 — 전환 완료 후의 최종 상태이기 때문이다.
#   그러나 **컷오버 +7일(롤백 창)까지는 서버 .env 의 기존 CLERK_* 줄을 지우지 말 것.**
#   롤백 대상인 구 api 이미지의 Settings 가 clerk_secret_key / clerk_webhook_secret 을
#   기본값 없이 요구한다. 지우면 migrate one-shot 이 죽어 deploy-rollback 자체가 실패한다.
#   신규 이미지는 config.py 의 extra="ignore" 로 무시하므로 남아 있어도 무해하다.
# issuer 는 토큰 iss/aud 와 대조하는 값 = FE 공개 URL.
# JWKS 는 실제로 공개키를 가져올 주소 — compose 내부망을 쓴다.
# 둘을 분리해야 Cloudflare Tunnel 왕복이 인증 경로에서 빠진다.
AUTH_JWT_ISSUER=https://kairos.woosung.dev
AUTH_JWT_AUDIENCE=https://kairos.woosung.dev
AUTH_JWKS_URL=http://web:3000/api/auth/jwks
AUTH_JWT_ALGORITHMS=EdDSA

# --- 인증 (web 컨테이너 = Better Auth 서버) ---------------------------------
# ★BETTER_AUTH_SECRET 은 세션 쿠키 서명 + auth_jwks.privateKey 암호화를 겸한다.
#   유출 = 임의 사용자 JWT 위조 가능. 생성: openssl rand -base64 32
#   절대 build.env 에 넣지 말 것 — build.env 는 --build-arg 로 이미지 레이어에 평문으로 박힌다.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://kairos.woosung.dev
# node-postgres 형식 (백엔드의 postgresql+asyncpg:// 와 다르다). 호스트명 db = compose 서비스명.
BETTER_AUTH_DATABASE_URL=postgresql://kairos:CHANGE_ME@db:5432/kairos
# ★Drive 연동(GOOGLE_OAUTH_CLIENT_ID)과 **다른** OAuth 클라이언트를 쓴다.
#   Drive 는 restricted scope 라 앱 검증 대상 — 로그인을 얹으면 같이 묶인다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudflare R2 ---------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- AI ---------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- 업로드 한도 -------------------------------------------------------------
# 90MB. 코드 기본값은 500MB 지만 Cloudflare Free/Pro 는 요청 바디를 100MB 에서 자른다.
# 엣지가 반환하는 413 에는 CORS 헤더가 없어 브라우저 콘솔에는 CORS 오류로 보인다.
# 서버가 먼저 한국어 메시지로 거절하도록 낮춰 둔다.
# 실측(2026-08-14): 회의 87건 중 최장 5.1분 / 약 5MB 이므로 여유는 20배다.
MAX_UPLOAD_BYTES=94371840

# --- 통합 / OAuth ------------------------------------------------------------
INTEGRATIONS_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://kairos-api.woosung.dev/api/v1/integrations/google-drive/callback
GOOGLE_PICKER_API_KEY=

# --- 운영 --------------------------------------------------------------------
# openssl rand -hex 32 로 생성. 미설정 시 코드 기본값(공개 리포에 적힌 문자열)이 쓰인다.
CRON_SECRET_TOKEN=
