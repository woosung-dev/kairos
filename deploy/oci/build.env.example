# FE 이미지 빌드 인자 (ADR-028)
#
# `mise run deploy-build <TAG>` 가 이 파일을 source 한다.
# deploy/oci/build.env 로 복사한 뒤 값을 채운다 (build.env 는 gitignore 대상).
#
# 여기 값들은 전부 NEXT_PUBLIC_* — 브라우저 번들에 인라인되므로 시크릿이 아니다.
# 다만 도메인이 바뀌면 반드시 이 파일을 고치고 재빌드해야 한다. 런타임 env 로는 바뀌지 않는다.

NEXT_PUBLIC_API_URL=https://kairos-api.woosung.dev
NEXT_PUBLIC_RECALL_ENABLED=true
NEXT_PUBLIC_FOUNDER_USER_ID=
NEXT_PUBLIC_APP_ENV=production

# ADR-026 — Google Drive 연동 (Picker). BE 의 GOOGLE_OAUTH_CLIENT_ID 와 **같은 값**이어야
# 한다 — drive.file 은 앱+파일 단위 grant 라, 브라우저가 Picker 로 얻은 grant 를 서버가
# 자기 refresh token 으로 읽으려면 client_id 가 동일해야 한다 (ADR-026 D5).
# ★로그인용 Google OAuth 클라이언트(apps/web 의 GOOGLE_CLIENT_ID)와는 **다른** 클라이언트다.
# 비우면 설정>연동 화면이 "Picker 설정이 주입되지 않았습니다" 로 뜨고 선택 창이 안 열린다.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
