# Kairos Frontend 환경변수 템플릿
# 이 파일을 .env.local로 복사한 후 실제 값을 입력하세요

# 백엔드 API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk (인증)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ─── E2E 테스트 (Playwright) ───
# 로컬에서 `pnpm e2e` 실행 시 필요. Clerk dashboard → Configure → Testing 에서
# testing mode 활성화 후 테스트 계정 + 고정 OTP를 설정한다.
E2E_USER_EMAIL=
E2E_USER_OTP=

# 선택: E2E가 바라볼 FE port/URL. 기본은 3003.
# E2E_PORT=3003
# E2E_BASE_URL=http://localhost:3003
