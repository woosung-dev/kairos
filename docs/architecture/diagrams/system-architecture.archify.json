  "cards": [
    { "dot": "cyan", "title": "경계", "items": [
      "호스트 인바운드는 SSH 22 하나 — 트래픽은 cloudflared 의 아웃바운드 터널로 들어온다",
      "cloudflared 만 host 네트워크 — iptables 가 22 외 INPUT 을 막아 브리지→loopback 경로가 없다",
      "공유 호스트 — 포트 3100/8200/5434 · cpus 1.5 · mem_limit 로 격리 (ADR-028 D1)"
    ] },
    { "dot": "emerald", "title": "상태와 소유", "items": [
      "DB 하나에 소유자 둘 — alembic 26 테이블 + Better Auth(web) 의 auth_* 5 테이블",
      "migrate 는 one-shot — 실패하면 api/web 이 뜨지 않는다 (crash-loop 방지, ADR-028 D6)",
      "uvicorn 워커 1 고정 — circuit breaker · JWT 캐시가 in-process 싱글턴"
    ] },
    { "dot": "amber", "title": "외부 의존", "items": [
      "런타임 로컬 ML 추론 0건 — STT·LLM·임베딩 전부 외부 API (ARM 이전 근거)",
      "Gemini gemini-3.1-flash-lite 고정 (ADR-019) · OpenAI Whisper + text-embedding-3-small",
      "로그인 Google OAuth 와 Drive 클라이언트 분리 — restricted scope 검증 반경 격리"
    ] }
