# Kairos Backend 환경변수 템플릿
# cp .env.example .env 후 실제 값을 입력하세요
# 발급처 및 CI/프로덕션 설정 → docs/guides/secrets.md

# 앱
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname

# Clerk (인증)
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Cloudflare R2 (파일 저장소)
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=kairos-uploads

# AI
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=sk-xxx

# Cron (Sprint 15 R-CRON — R2 30일 voice cleanup admin endpoint 인증)
# 발급: openssl rand -hex 32
# Cloud Scheduler에서 X-Cron-Token 헤더로 매일 03:00 KST 호출
CRON_SECRET_TOKEN=dev-cron-secret-CHANGE-ME-IN-PROD
